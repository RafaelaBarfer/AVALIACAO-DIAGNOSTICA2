using System;
namespace AvaliacaoDiagnostica {
    class questao04 {
static void Main ()
{
string[,] dados = new string[5, 2]; // 5 linhas, 2 colunas (Nome e Nota)
int opcao = 0;

while (opcao != 4) {
    Console.WriteLine("\n1- Cadastrar\n2- Listar\n3- Média\n4- Sair");
    opcao = int.Parse(Console.ReadLine());

    if (opcao == 1) {
        for (int i = 0; i < 5; i++) {
            Console.Write($"Nome do aluno {i+1}: ");
            dados[i, 0] = Console.ReadLine();
            Console.Write($"Nota do aluno {i+1}: ");
            dados[i, 1] = Console.ReadLine();
        }
    } else if (opcao == 2) {
        for (int i = 0; i < 5; i++) {
            Console.WriteLine($"Aluno: {dados[i,0]} | Nota: {dados[i,1]}");
        }
    } else if (opcao == 3) {
    double soma = 0;
    for (int i = 0; i < 5; i++) {
        // Tenta converter. Se falhar, a nota será tratada como 0
        if (double.TryParse(dados[i, 1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double nota)) {
            soma += nota;
        } else if (double.TryParse(dados[i, 1], out double notaBrasil)) {
            soma += notaBrasil;
        }
    } 
            Console.WriteLine($"\nMédia da turma: {soma / 5:F2}");
        } 
    } 
}
}
}
