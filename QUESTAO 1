using System;

class Program {
    static void Main() {
        int opcao = 0;

        while (opcao != 5) {
            Console.WriteLine("\n===== MENU =====");
            Console.WriteLine("1- Somar\n2- Subtrair\n3- Multiplicar\n4- Dividir\n5- Sair");
            Console.Write("Escolha uma opção: ");
            
            if (!int.TryParse(Console.ReadLine(), out opcao)) continue;

            if (opcao >= 1 && opcao <= 4) {
                Console.Write("Digite o 1º número: ");
                double n1 = double.Parse(Console.ReadLine());
                Console.Write("Digite o 2º número: ");
                double n2 = double.Parse(Console.ReadLine());

                switch (opcao) {
                    case 1: Console.WriteLine($"Resultado: {n1 + n2}"); break;
                    case 2: Console.WriteLine($"Resultado: {n1 - n2}"); break;
                    case 3: Console.WriteLine($"Resultado: {n1 * n2}"); break;
                    case 4: 
                        if (n2 != 0) Console.WriteLine($"Resultado: {n1 / n2}");
                        else Console.WriteLine("Erro: Divisão por zero!");
                        break;
                }
            }
        }
    }
}
